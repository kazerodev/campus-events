# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Default: api/data/events.sqlite
# DB_STORAGE=./data/events.sqlite

# Confirmation mail. Without SMTP_URL the slow lab mailer (api/lab/mail.mjs) is used: it only logs.
# Example with Brevo: smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
# SMTP_URL=
# MAIL_FROM=Campus Events <no-reply@example.com>

# How long a cached GET answer may live. Every write clears the cache anyway.
CACHE_TTL_SECONDS=30

# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
