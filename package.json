{
  "name": "campus-events",
  "version": "1.0.0",
  "private": true,
  "description": "Starter project for Advanced Development (Thomas More, IXD year 3): Express API + Vue frontend",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "start": "node api/src/server.mjs",
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "seed": "npm run seed -w api",
    "test": "npm test --workspaces",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "build": "npm run build -w web",
    "build:check": "node -e \"require('fs').accessSync('web/dist/index.html')\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0"
  }
}
